<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Petal Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>
<body ng-app="FlowerShopWebApplicationModule" ng-controller="FlowerShopWebApplicationController" class="font-['Poppins']">


    <nav ng-init="navigationTitleFunc()" class="flex items-center bg-rose-950 p-3 flex-wrap pl-5 shadow-lg shadow-black/30">
        <a href="#" class="p-2 mr-4 inline-flex items-center">
            <span class="text-xl text-rose-200 font-bold uppercase tracking-wide">Petal Studio</span>
        </a>
        <button class="text-white inline-flex p-3 hover:bg-gray-900 rounded lg:hidden ml-auto hover:text-white outline-none nav-toggler"
                data-target="#navigation">
            <i class="material-icons">menu</i>
        </button>

        <div class="hidden top-navbar w-full lg:inline-flex lg:flex-grow lg:w-auto pr-5"
             id="navigation">

            <div class="lg:inline-flex lg:flex-row lg:ml-auto lg:w-auto w-full lg:items-center items-start  flex flex-col lg:h-auto gap-7">
                <a ng-click="homePageRedirectFunc()"href="#"
                   class="lg:inline-flex lg:w-auto w-full px-3 py-2 rounded text-rose-200 items-center justify-center hover:bg-pink-900 hover:text-white font-bold">
                    <span>{{homeTitle}}</span>
                </a>
                <a href="#" ng-click="aboutRedirectFunc()"
                   class="lg:inline-flex lg:w-auto w-full px-3 py-2 rounded text-rose-200 items-center justify-center hover:bg-pink-900 hover:text-white font-bold">
                    <span>{{aboutTitle}}</span>
                </a>
                <a href="#" ng-click="contactRedirectFunc()"
                   class="lg:inline-flex lg:w-auto w-full px-3 py-2 rounded text-rose-200 items-center justify-center hover:bg-pink-900 hover:text-white font-bold">
                    <span>{{contactTitle}}</span>
                </a>
                <a href="#" ng-click="registerRedirectFunc()"
                   class="bg-pink-100 lg:inline-flex w-32 px-3 py-2 rounded-full text-pink-800 items-center justify-center hover:bg-pink-900 hover:text-white font-bold">
                    <span>{{signupTitle}}</span>
                </a>


            </div>
        </div>
    </nav>

    <div>
        @RenderBody()
    </div>

    <div class="bg-rose-100 p-7">
        <footer>
            <div class="flex gap-lg-5 justify-content-between align-items-center">

                <div class="flex-1 text-center">
                    <p>&copy; @DateTime.Now.Year - Petal Studio</p>
                </div>

                <div class="flex-1 text-center">
                    <p class="text-xl text-rose-800 font-bold uppercase tracking-wide">Petal Studio</p>
                </div>

                <div class="flex-1 text-center">
                    <p>&copy; @DateTime.Now.Year - Petal Studio</p>
                </div>

        

            </div>
        </footer>
    </div>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>

    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>

</body>
</html>
