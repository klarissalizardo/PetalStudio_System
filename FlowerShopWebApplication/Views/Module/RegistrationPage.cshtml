@{
    Layout = "~/Views/Shared/_ManagementFormsLayout.cshtml";
}

<div class="flex min-h-screen flex-col justify-center px-6 py-12 lg:px-8 bg-gradient-to-br from-pink-100 to-rose-200">


    <div class="flex mt-10 sm:mx-auto sm:w-full sm:max-w-6xl bg-white rounded-2xl shadow-lg">

        <div class="w-96 rounded-l-2xl overflow-hidden">
            <img src="~/Content/Images/FlowerBouquetLogin.jpg" class="w-full h-full object-cover" />
        </div>

        <div class="flex-1 p-8">
            <h1 ng-init="titleRegistrationFunc()" class="mt-5 text-center text-5xl font-bold tracking-tight text-pink-900 mb-5 pt-7">{{registrationTitle}}</h1>
            <h4 class="mt-5 text-center text-l font-bold tracking-tight text-pink-900  mb-lg-5">{{registrationSubtitle}}</h4>

            <form action="#" name="registrationForm" method="POST" class="space-y-3 max-w-md mx-auto" novalidate>

                <div class="flex pt-4 gap-4">

                    <div class="flex-1 mt-2">
                        <label for="firstname" class="block text-sm/6 font-medium text-gray-900">Firstname *</label>
                        <input ng-model="firstname" name="firstname" id="firstname" type="text" required
                               ng-pattern="/^[a-zA-Z0-9\s'-]*$/" minlength="2" maxlength="1100" autocomplete="off"
                               class="mt-2 block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.firstname.$dirty || registrationForm.$submitted)&& registrationForm.firstname.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Firstname is required.
                        </p>
                        <p ng-show="(registrationForm.firstname.$dirty || registrationForm.$submitted) && registrationForm.firstname.$error.pattern" class="text-red-600 text-sm font-medium mt-1">
                            Must only contain letters, numbers, spaces, or hyphens.
                        </p>
                        <p ng-show="(registrationForm.firstname.$dirty || registrationForm.$submitted) && registrationForm.firstname.$error.minlength" class="text-red-600 text-sm font-medium mt-1">
                            Must be at least 2 characters long.
                        </p>
                        <p ng-show="(registrationForm.firstname.$dirty || registrationForm.$submitted) && registrationForm.firstname.$error.maxlength" class="text-red-600 text-sm font-medium mt-1">
                            Must not exceed 50 characters.
                        </p>
                      

                    </div>


                    <div class="flex-1 mt-2">
                        <label for="lastname" class="block text-sm/6 font-medium text-gray-900">Lastname *</label>
                        <input ng-model="lastname" name="lastname" id="lastname" type="text" required
                               ng-pattern="/^[a-zA-Z0-9\s'-]*$/" minlength="2" maxlength="50"
                               class="mt-2 block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.lastname.$dirty || registrationForm.$submitted) && registrationForm.lastname.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Lastname is required.
                        </p>
                        <p ng-show="(registrationForm.lastname.$dirty || registrationForm.$submitted) && registrationForm.lastname.$error.pattern" class="text-red-600 text-sm font-medium mt-1">
                            Must only contain letters, numbers, spaces, or hyphens.
                        </p>
                        <p ng-show="(registrationForm.lastname.$dirty || registrationForm.$submitted) && registrationForm.lastname.$error.minlength" class="text-red-600 text-sm font-medium mt-1">
                            Must be at least 2 characters long.
                        </p>
                        <p ng-show="(registrationForm.lastname.$dirty || registrationForm.$submitted) && registrationForm.lastname.$error.maxlength" class="text-red-600 text-sm font-medium mt-1">
                            Must not exceed 50 characters.
                        </p>
                       

                    </div>


                </div>


                <div class="">
                    <label for="username" class="block text-sm/6 font-medium text-gray-900">Username *</label>
                    <div class="mt-2">
                        <input ng-model="username" name="username" id="username" type="text" required
                               ng-pattern="/^[a-zA-Z0-9_]*$/" minlength="4" maxlength="20" autocomplete="off"
                               class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.username.$dirty || registrationForm.$submitted) && registrationForm.username.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Username is required.
                        </p>
                        <p ng-show="(registrationForm.username.$dirty || registrationForm.$submitted) && registrationForm.username.$error.pattern" class="text-red-600 text-sm font-medium mt-1">
                            Must only contain letters, numbers, or underscores.
                        </p>
                        <p ng-show="(registrationForm.username.$dirty || registrationForm.$submitted) && registrationForm.username.$error.minlength" class="text-red-600 text-sm font-medium mt-1">
                            Must be at least 4 characters long.
                        </p>
                        <p ng-show="(registrationForm.username.$dirty || registrationForm.$submitted) && registrationForm.username.$error.maxlength" class="text-red-600 text-sm font-medium mt-1">
                            Must not exceed 20 characters.
                        </p>
                        <p ng-show="(registrationForm.username.$dirty || registrationForm.$submitted) && !registrationForm.username.$error.required && !checkUsernameUnique()" class="text-red-600 text-sm font-medium mt-1">
                            Username already exists.
                        </p>
                       
                    </div>
                </div>

                <div class="">
                    <label for="email" class="block text-sm/6 font-medium text-gray-900 ">Email address *</label>
                    <div class="mt-2">
                        <input ng-model="email" name="email" id="email" type="text" required
                               ng-pattern="/^[a-zA-Z0-9._%+-]+\u0040[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/"
                               autocomplete="off"
                               class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.email.$dirty || registrationForm.$submitted) && registrationForm.email.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Email is required.
                        </p>
                        <p ng-show="(registrationForm.email.$dirty || registrationForm.$submitted) && registrationForm.email.$error.pattern" class="text-red-600 text-sm font-medium mt-1">
                            Not a valid email.
                        </p>
                        <p ng-show="(registrationForm.email.$dirty || registrationForm.$submitted) && !registrationForm.email.$error.required && !registrationForm.email.$error.pattern && !checkEmailUnique()" class="text-red-600 text-sm font-medium mt-1">
                            Email already in used.
                        </p>
                       

                    </div>
                </div>



                <div>
                    <label for="password" class="block text-sm/6 font-medium text-gray-900">Password *</label>
                    <div class="mt-2">
                        <input ng-model="password" name="password" id="password" type="password" required minlength="8" maxlength="50"
                               autocomplete="current-password"
                               class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.password.$dirty || registrationForm.$submitted) && registrationForm.password.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Please enter a password.
                        </p>
                        <p ng-show="(registrationForm.password.$dirty  || registrationForm.$submitted) && registrationForm.password.$error.minlength" class="text-red-600 text-sm font-medium mt-1">
                            Needs at least 8 characters.
                        </p>
                        <p ng-show="(registrationForm.password.$dirty || registrationForm.$submitted) && !registrationForm.password.$error.minlength && !hasUpper()" class="text-red-600 text-sm font-medium mt-1">
                            Add at least one uppercase letter.
                        </p>
                        <p ng-show="(registrationForm.password.$dirty  || registrationForm.$submitted) && !registrationForm.password.$error.minlength && hasUpper() && !hasLower()" class="text-red-600 text-sm font-medium mt-1">
                            Add at least one lowercase letter.
                        </p>
                        <p ng-show="(registrationForm.password.$dirty || registrationForm.$submitted) && !registrationForm.password.$error.minlength && hasUpper() && hasLower() && !hasNumber()" class="text-red-600 text-sm font-medium mt-1">
                            Add at least one number.
                        </p>
                        <p ng-show="(registrationForm.password.$dirty || registrationForm.$submitted)  && !registrationForm.password.$error.minlength && hasUpper() && hasLower() && hasNumber() && !hasSpecial()" class="text-red-600 text-sm font-medium mt-1">
                            Add at least one special character.
                        </p>
                       

                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between">
                        <label for="confirm_password" class="block text-sm/6 font-medium text-gray-900">Confirm Password *</label>

                    </div>
                    <div class="mt-2">
                        <input ng-model="confirmPassword" name="confirmPassword" id="confirm_password" type="password" required
                               autocomplete="current-password"
                               class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.confirmPassword.$dirty || registrationForm.$submitted) && registrationForm.confirmPassword.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Please confirm your password.
                        </p>
                        <p ng-show="(registrationForm.confirmPassword.$dirty || registrationForm.$submitted) && !registrationForm.confirmPassword.$error.required && !passwordsMatch()" class="text-red-600 text-sm font-medium mt-1">
                            Passwords do not match.
                        </p>
                      
                    </div>
                </div>

                <div class="">
                    <label for="contact" class="block text-sm/6 font-medium text-gray-900">Contact </label>
                    <div class="mt-2">
                        <input ng-model="contact" name="contact" id="contact" type="text" required
                               ng-pattern="/^[0-9]*$/" minlength="10" maxlength="13"
                               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                               class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                        <p ng-show="(registrationForm.contact.$dirty || registrationForm.$submitted) && registrationForm.contact.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Contact number is required.
                        </p>
                        <p ng-show="(registrationForm.contact.$dirty || registrationForm.$submitted) && registrationForm.contact.$error.pattern" class="text-red-600 text-sm font-medium mt-1">
                            Contact number must only contain digits.
                        </p>
                        <p ng-show="(registrationForm.contact.$dirty || registrationForm.$submitted) && !registrationForm.contact.$error.pattern && registrationForm.contact.$error.minlength" class="text-red-600 text-sm font-medium mt-1">
                            Invalid contact number
                        </p>
                        <p ng-show="(registrationForm.contact.$dirty || registrationForm.$submitted) && !registrationForm.contact.$error.pattern && registrationForm.contact.$error.maxlength" class="text-red-600 text-sm font-medium mt-1">
                            Invalid contact number
                        </p>
                       

                    </div>
                </div>

                <div class="flex gap-4">

                    <div class="mt-2 flex-1">
                        <label for="roles" class="block text-sm/6 font-medium text-gray-900 ">Roles *</label>
                        <select ng-model="role" name="role" required
                                class="mt-2 block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6">
                            <option value="" selected disabled>-- Select --</option>
                            <option>Customer</option>
                            <option>Employee</option>
                        </select>
                        <p ng-show="registrationForm.role.$dirty && registrationForm.role.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Please select a role.
                        </p>
                      
                    </div>

                    <div class="mt-2 flex-1">
                        <label for="department" class="block text-sm/6 font-medium text-gray-900 ">Department *</label>
                        <select ng-model="department" name="department" ng-required="role === 'Employee'"
                                class="mt-2 block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6">
                            <option value="" selected disabled>-- Select --</option>
                            <option>Arrangement</option>
                            <option>Sales</option>
                            <option>Delivery</option>
                            <option>Inventory</option>
                            <option>Administration</option>
                        </select>
                        <p ng-show="registrationForm.department.$dirty && registrationForm.department.$error.required" class="text-red-600 text-sm font-medium mt-1">
                            Please select a department.
                        </p>
                       
                       

                    </div>
                </div>



                <div class="flex gap-2 pt-5">
                    <button type="button" ng-click="registrationFunc()" class="flex w-full justify-center rounded-md bg-pink-400 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Register</button>
                    <button type="button" ng-click="clearFunc()" class=" justify-center rounded-md bg-pink-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Cancel</button>

                </div>
            </form>

            <p class="pt-6 text-center text-sm/6 text-gray-500">
                Already have an account?
                <a href="#" ng-click="loginRedirectFunc()" class="font-semibold text-pink-600 hover:text-pink-800">Log In</a>
            </p>
        </div>
    </div>



<div class="flex mt-10 sm:mx-auto l:w-full sm:max-w-6xl bg-white rounded-2xl shadow-lg">


    <div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base">

        <table class="w-full text-sm text-left rtl:text-right text-body">

            <thead class="bg-pink-200 border-b border-default">

                <tr>
                    <th scope="col" class="px-6 py-3 font-medium"> Firstname </th>
                    <th scope="col" class="px-6 py-3 font-medium"> Lastname </th>
                    <th scope="col" class="px-6 py-3 font-medium"> Username</th>
                    <th scope="col" class="px-6 py-3 font-medium"> Email </th>
                    @*<th scope="col" class="px-6 py-3 font-medium"> Password </th>*@
                    <th scope="col" class="px-6 py-3 font-medium"> Contact </th>
                    <th scope="col" class="px-6 py-3 font-medium"> Role </th>
                    <th scope="col" class="px-6 py-3 font-medium"> Department </th>
                    <th scope="col" class="px-6 py-3 font-medium"> Action </th>
                </tr>
            </thead>

            <tbody>
                <tr ng-repeat="userData in usersArray" class="odd:bg-neutral-primary even:bg-neutral-secondary-soft border-b border-default text-center">

                    <td class="px-6 py-4"> {{userData.firstname}} </td>
                    <td class="px-6 py-4"> {{userData.lastname}} </td>
                    <td class="px-6 py-4"> {{userData.username}}</td>
                    <td class="px-6 py-4"> {{userData.email}}</td>
                    @*<td class="px-6 py-4"> {{userData.password}}</td>*@
                    <td class="px-6 py-4"> {{userData.contact}}</td>
                    <td class="px-6 py-4"> {{userData.role}}</td>
                    <td class="px-6 py-4"> {{userData.department}}</td>
                    <td>
                        <div class="flex gap-3 py-4 px-5">
                            <button type="button" ng-click="loadUserEditFunc($index)" class="w-full justify-center rounded-md bg-pink-400 px-5 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Edit</button>
                            <button type="button" ng-click="editFunc()" ng-show="editUserId !== undefined" class="w-full justify-center rounded-md bg-pink-300 px-5 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Update</button>
                            <button type="submit" ng-click="deleteFunc($index)" class=" justify-center rounded-md bg-pink-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Delete</button>

                        </div>

                    </td>
                </tr>
                
            </tbody>
        </table>
    </div>

</div>


</div>


