@{
    Layout = "~/Views/Shared/_ManagementFormsLayout.cshtml";
}

<div class="flex min-h-screen flex-col justify-center px-6 py-12 lg:px-8 bg-gradient-to-br from-pink-100 to-rose-200">


    <div class="flex mt-10 sm:mx-auto sm:w-full sm:max-w-6xl bg-white rounded-2xl shadow-lg">

        <div class="w-96 rounded-l-2xl overflow-hidden">
            <img src="~/Content/Images/FlowerBouquetLogin.jpg" class="w-full h-full object-cover" />
        </div>

        <div class="flex-1 p-8">
            <h1 class="mt-5 text-center text-5xl font-bold tracking-tight text-pink-900 mb-5 pt-7">WELCOME BACK</h1>
            <h4 class="mt-5 text-center text-l font-bold tracking-tight text-pink-900  mb-lg-5">Log in to your account</h4>



            <form action="#" method="POST" class="space-y-6 max-w-md mx-auto">
                <div class="pt-2">
                    <label for="email" class="block text-sm/6 font-medium text-gray-900 mt-10">Username</label>
                    <div class="mt-2">
                        <input id="username" type="text" name="username" class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between">
                        <label for="password" class="block text-sm/6 font-medium text-gray-900">Password</label>
                    </div>
                    <div class="mt-2">
                        <input id="password" type="password" name="password" required autocomplete="current-password" class="block w-full rounded-md bg-rose-100 px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-pink-600 sm:text-sm/6" />
                    </div>
                </div>


                <div class="flex items-center justify-end ">

                    <div class="text-sm ">
                        <a href="#" class="font-semibold text-pink-600 hover:text-pink-800">Forgot password?</a>
                    </div>

                </div>


                <div class="flex gap-2 pt-3">
                    <button ng-click="homeRedirectFunc()" type="button" class="flex w-full justify-center rounded-md bg-pink-400 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Log In</button>
                    <button ng-click="clearFunc()" class=" justify-center rounded-md bg-pink-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-pink-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Cancel</button>
                    
                </div>
            </form>

            <div>

            </div>
            <p class="mt-10 text-center text-sm/6 text-gray-500">
                Don't have an account?
                <a href="#" ng-click="registerRedirectFunc()" class="font-semibold text-pink-600 hover:text-pink-800">Register Here</a>
            </p>
        </div>
    </div>
</div>